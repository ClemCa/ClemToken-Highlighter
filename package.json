{
  "name": "clemtoken-highlighter",
  "displayName": "ClemToken Highlighter",
  "description": "Syntax higlighting for the unreleased ClemToken grammar DSL",
  "publisher": "ClemCa",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClemCa/ClemToken-Highlighter.git"
  },
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:clemtoken"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "clemtoken",
        "extensions": [
          ".ct"
        ],
        "aliases": [
          "ClemToken",
          "clemtoken"
        ]
      }
    ],
    "configurationDefaults": {
      "[clemtoken]": {
        "editor.language.brackets": [
          [
            "$[",
            "]"
          ],
          [
            "(",
            ")"
          ]
        ],
        "editor.language.colorizedBracketPairs": [
          [
            "(",
            ")"
          ]
        ]
      }
    }
  },
  "configuration": {
    "title": "ClemToken Highlighter",
    "properties": {
      "clemtoken.selectorColor": {
        "type": "string",
        "default": "#4EC9B0",
        "description": "Selector color"
      },
      "clemtoken.keywordColor": {
        "type": "string",
        "default": "#569CD6",
        "description": "Keyword color"
      },
      "clemtoken.nameColor": {
        "type": "string",
        "default": "#808080",
        "description": "Group name color"
      },
      "clemtoken.affixColor": {
        "type": "string",
        "default": "#FF69B4",
        "description": "Affix color"
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.103.0",
    "@vscode/test-cli": "0.0.11",
    "@vscode/test-electron": "2.5.2",
    "esbuild": "^0.25.9",
    "typescript": "5.9.2"
  }
}
