{
  "name": "clemtoken-highlighter",
  "displayName": "ClemToken Highlighter",
  "description": "Syntax highlighting for the unreleased ClemToken grammar DSL.",
  "publisher": "ClemCa",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClemCa/ClemToken-Highlighter.git"
  },
  "version": "1.6.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
  ],
  "main": "./dist/extension.js",
  "license": "SEE LICENSE IN LICENSE",
  "contributes": {
    "commands": [
      {
        "command": "clemtoken.showGrammarStats",
        "title": "ClemToken: Show Grammar Stats",
        "enablement": "editorLangId == clemtoken"
      },
      {
        "command": "clemtoken.profileGrammar",
        "title": "ClemToken: Profile Grammar",
        "enablement": "editorLangId == clemtoken"
      }
    ],
    "languages": [
      {
        "id": "clemtoken",
        "extensions": [
          ".ct"
        ],
        "aliases": [
          "ClemToken",
          "clemtoken"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "clemtoken-abstract",
        "extensions": [
          ".cta"
        ],
        "aliases": [
          "ClemToken Abstract",
          "clemtoken-abstract"
        ]
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "clemtoken",
        "scopes": {
          "comment": [
            "comment"
          ],
          "keyword": [
            "keyword"
          ],
          "variable": [
            "variable"
          ],
          "regexp": [
            "string.regexp"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[clemtoken]": {
        "editor.language.brackets": [
          [
            "$[",
            "]"
          ],
          [
            "(",
            ")"
          ],
          [
            "[",
            "]"
          ]
        ],
        "editor.language.colorizedBracketPairs": [
          [
            "(",
            ")"
          ]
        ]
      },
      "[clemtoken-abstract]": {
        "editor.language.brackets": [
          [
            "(",
            ")"
          ]
        ],
        "editor.language.colorizedBracketPairs": [
          [
            "(",
            ")"
          ]
        ]
      }
    }
  },
  "configuration": {
    "title": "ClemToken Highlighter",
    "properties": {
      "clemtoken.enginePath": {
        "type": "string",
        "default": "",
        "description": "Path to a ClemToken engine binary. Empty uses the one bundled with the extension."
      },
      "clemtoken.selectorColor": {
        "type": "string",
        "default": "#4EC9B0",
        "description": "Selector color"
      },
      "clemtoken.keywordColor": {
        "type": "string",
        "default": "#4a9d4cff",
        "description": "Reserved spec name color, the part inside $[...]"
      },
      "clemtoken.nameColor": {
        "type": "string",
        "default": "#808080",
        "description": "Group name color"
      },
      "clemtoken.affixColor": {
        "type": "string",
        "default": "#FF69B4",
        "description": "Affix color"
      },
      "clemtoken.titleColor": {
        "type": "string",
        "default": "#02ADF6",
        "description": "Title color"
      },
      "clemtoken.anchorColor": {
        "type": "string",
        "default": "#569CD6",
        "description": "Anchor color"
      },
      "clemtoken.anchorBaseColor": {
        "type": "string",
        "default": "#8EB5D4",
        "description": "Anchor base color"
      },
      "clemtoken.optionalColor": {
        "type": "string",
        "default": "#FFB6C1",
        "description": "Optional color"
      },
      "clemtoken.activeColor": {
        "type": "string",
        "default": "#8B5CF6",
        "description": "Color for the construct described by the current-line inlay hint"
      },
      "clemtoken.specColor": {
        "type": "string",
        "default": "#dcdcaa",
        "description": "Spec declaration color, the $target: part of a spec line"
      },
      "clemtoken.specModeColor": {
        "type": "string",
        "default": "#9cdcfe",
        "description": "Spec mode color, the mode part of $target:mode:regex"
      },
      "clemtoken.specRegexColor": {
        "type": "string",
        "default": "#c586c0",
        "description": "Spec regex color, the body of a spec line"
      },
      "clemtoken.lookaheadColor": {
        "type": "string",
        "default": "#209b49",
        "description": "Lookahead marker color, the @>> of a lookahead"
      },
      "clemtoken.lookaheadTextColor": {
        "type": "string",
        "default": "#31f227",
        "description": "Lookahead probe color, the body inside a lookahead"
      },
      "clemtoken-abstract.fieldColor": {
        "type": "string",
        "default": "#4a9d4cff",
        "description": "Field color"
      },
      "clemtoken-abstract.colonColor": {
        "type": "string",
        "default": "#4EC9B0",
        "description": "Colon color"
      },
      "clemtoken-abstract.stringColor": {
        "type": "string",
        "default": "#CE9178",
        "description": "String color"
      },
      "clemtoken.bracketColors": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "#FFD700",
          "#DA70D6",
          "#179FFF",
          "#00C957",
          "#FF7F50",
          "#40E0D0"
        ],
        "description": "Colors for group parentheses, cycled by nesting depth. An empty list turns the rainbow off."
      },
      "clemtoken.showCodeLens": {
        "type": "boolean",
        "default": true,
        "description": "Show a reference count above each rule definition, as a shortcut to Find References."
      },
      "clemtoken.statsDebounceMs": {
        "type": "number",
        "default": 1200,
        "minimum": 0,
        "description": "Delay before grammar stats are computed after an edit. A hover or command computes them immediately when they are stale."
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production",
    "stage-engine": "node scripts/stage-engine.mjs",
    "release": "node scripts/publish.mjs",
    "release:package": "node scripts/publish.mjs --package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.9",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.9": true
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.2"
  },
  "dependencies": {
    "randexp": "^0.6.0"
  }
}
